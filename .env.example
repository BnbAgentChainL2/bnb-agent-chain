# Copy to .env — never commit .env. The deployer key must be a FRESH wallet:
# any key that has appeared in a chat log or a file is compromised.
# Every value here is EMPTY on purpose. Names only; never paste a private key into any file
# that is not .env, and never into a chat, a document or a shell history.

# ── BSC side (chainId 56) ────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=             # prefer a Foundry keystore instead: `cast wallet import bac-deployer --interactive`
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BSCSCAN_API_KEY=                  # Etherscan V2 key; only ever typed in a shell, at verification time
ETHERSCAN_API_KEY=                # same key, the name `forge verify-contract` reads
OWNER_BUCKET_WALLET=              # Cold wallet / multisig that receives the node-fund half

# ── contracts/script/DeployBac.s.sol ─────────────────────────────────────
# Read by name. The script DRY RUNS by default: it only sends when BOTH `--broadcast` is on the
# command line AND BAC_BROADCAST below is set to the passphrase.
#   dry run:    forge script script/DeployBac.s.sol:DeployBac --rpc-url "$BSC_RPC_URL" --sender 0x<deployer>
#   rehearsal:  scripts/anvil_rehearsal.sh
BAC_BROADCAST=                    # leave EMPTY. Only `I_HAVE_READ_SECTION_9` arms a real broadcast.
BAC_DEPLOYER_ADDRESS=             # optional; defaults to --sender / --account. Must deploy all of 3-10.
BAC_ADMIN=                        # cold key: relayer rotation (48h timelock), validator removal
BAC_VETO_KEY=                     # cold key: veto, and cancelling a queued rotation. MUST differ from BAC_ADMIN
BAC_RELAYER=                      # hot key that posts anchors. Its own key, not admin, not veto
BAC_WATCHDOG=                     # BacBridge watchdog. Must not be the relayer
BAC_NODE_FUND_OWNER=              # owner of BacNodeFund — the cold wallet that withdraws the node-fund half
BAC_LAUNCHER=                     # the wallet that will press Launch on flap.sh. Burned into the factory as an immutable
BAC_VAULT_OWNER=                  # vault owner written into vaultData; 0x0 (or empty) means the launching wallet
BAC_TOKEN_PREDICTED=              # T: the ...7777 CREATE2 token address mined in §9 ① and locked with Portal.lockSalt
BAC_INITIAL_CIRCULATING=1000000000000000000000   # OPERATOR_FLOAT = 1000e18. Do not change
BAC_FORK_BLOCK=                   # optional pin for `forge test --match-path test/BacForkLaunch.t.sol`

# ── contracts/script/DeployBac.s.sol:SetVaultSink (step ⑫, after the launch) ──
BAC_AGENT_REGISTRY=               # the AgentRegistry deployed above
BAC_VAULT=                        # the BacTreasuryVault created by the launch transaction

# ── scripts/sim_launch.sh (read-only eth_call simulation) ────────────────
# TAXDURATION and ANTIFARMER have NO defaults anywhere and are not read from .env:
# you type them on the command line every single time (docs/01-CONTRACT-SPEC.md §9).
#   TAXDURATION=3153600000 ANTIFARMER=86400 scripts/sim_launch.sh --factory 0x... --bridge 0x... \
#     --nodefund 0x... --launcher 0x... --salt 0x...

# ── Filled in after deployment ───────────────────────────────────────────
VAULT_FACTORY=
BAC_TOKEN=
BAC_VAULT_ADDRESS=
BAC_VAULT_UI_LIBRARY=             # BacVaultUI, CREATE2 salt 0 — needed for BscScan verification
BAC_BEACON=
BAC_VAULT_IMPLEMENTATION=
AGENT_REGISTRY=
CHAIN_ANCHOR=
BRIDGE=
NODE_FUND=
VALIDATOR_STAKING=

# ── Layer (chainId 56777, Hyperledger Besu + QBFT) ───────────────────────
LAYER_RPC_URL=
LAYER_CHAIN_ID=56777
BESU_NODE_KEY_PATH=               # Path to the Besu node key file. This key is BOTH the
                                  # enode identity AND the QBFT validator identity: losing it
                                  # stops the chain permanently. chmod 600, never in the repo.
RELAYER_PRIVATE_KEY=              # Relayer signing key, BSC side
RELAYER_LAYER_PRIVATE_KEY=        # Relayer signing key, layer side (may differ)

# ── Website ──────────────────────────────────────────────────────────────
VERCEL_TOKEN=
