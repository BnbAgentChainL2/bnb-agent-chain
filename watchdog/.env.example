# 看门狗的环境变量（**只写名字，值一律留空**）。复制为 .env 或 secrets/watchdog.env，永远不要提交。
# 私钥只从这里按变量名读，进程内不打印、不落盘、不进日志（src/log.mjs 会把它从任何输出里擦掉）。

# ---- 私钥 ----------------------------------------------------------------
# 看门狗那把热钥。它在 BacBridge 里是 immutable 的 `watchdog`，能做的事只有
# pause / unpause / armEscape / revokeEpochOwed —— **没有任何一条路径能动 BNB 或 BAC**。
# 启动自检会现读 `BacBridge.watchdog()` 和它对一遍，对不上直接拒绝启动。
WATCHDOG_PRIVATE_KEY=

# 可选。artifacts/sim/RESULTS-buyback.md §3.3 B6 的结论是：**只有在 120 秒内 veto 才是零损失**，
# 而 `ChainAnchor.veto()` 今天只允许 admin / vetoKey 调用，且规格里写明 vetoKey 是冷钥。
# 冷钥在 120 秒内签不出来。运维如果接受那份报告的建议、把 vetoKey 改成交给这个常驻进程的热钥，
# 就填这一项；填了之后看门狗会**先 veto 再 pause**。
# 留空 = 看门狗只能 pause()，而 pause 撤不回已经锁定的 owed —— README「已知的能力缺口」里写了代价。
WATCHDOG_VETO_PRIVATE_KEY=

# ---- 上链开关 ------------------------------------------------------------
# 必须显式写 true 或 false，没有默认值：
#   true  = 真的会发出 pause() 交易
#   false = 演练模式，检测照跑、告警照发，一笔交易都不发
# 给它任何默认值都是错的：默认 false 会让运维以为桥有刹车而其实没有；
# 默认 true 会让一次演练直接暂停主网的 collect。
WATCHDOG_ARMED=

# ---- RPC -----------------------------------------------------------------
# BSC 必须两个**独立**的端点：跳闸前的复核读走第二个，两个名字指向同一台机器时，
# 「复核」只是把同一个错误读了两遍。配置校验会直接拒绝两个相同的 URL。
BSC_RPC=https://bsc-rpc.publicnode.com
BSC_RPC_2=https://bsc-dataseed.bnbchain.org

# 层内节点。compose 里走内网。
LAYER_RPC=http://besu:8545
# 可选的第二个层内端点。**目前没有**：官方只有一台出块节点（信任表第一行）。
# 留空时锚点根的复核读会退化成「隔一会儿再读同一台」，只能排除瞬时读取错误，
# 排不掉节点本身说谎。启动时会为此打一条 warn。
LAYER_RPC_2=

# ---- SQLite（游标、影子账本、发现的生命周期）-----------------------------
WATCHDOG_DB=/var/bac/watchdog.db

# ---- BSC 侧合约地址（发射后回填，EIP-55 校验和格式）-----------------------
BAC_BRIDGE=
CHAIN_ANCHOR=
BAC_TOKEN=

# ---- 层内地址 ------------------------------------------------------------
# 创世系统合约地址由 02-CHAIN-SPEC §2 写死，下面是默认值，通常不用改。
L2_BRIDGE=0x0000000000000000000000000000000000000101
FEE_SINK=0x000000000000000000000000000000000000dEaD
FEE_SPLITTER=0x0000000000000000000000000000000000000104
# 出块者（QBFT 提案者）的 EOA：小费进这里，对账时必须与 FeeSink 分开读。
LAYER_SIGNER_ADDRESS=
# everValidator 累积表：历史上出现过的全部验证者地址，逗号分隔。留空退回 LAYER_SIGNER_ADDRESS。
LAYER_VALIDATORS=

# ---- 回购规则要用的两个外部地址 ------------------------------------------
# Flap Portal：复算回购参考价时读 getTokenV8Safe。留空时回购规则只做上下限检查。
FLAP_VAULT_PORTAL=
# PancakeSwap V2 router（BAC 毕业之后的参考价来源）。
PANCAKE_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E

# ---- 扫描起点（第一次启动时写进 cursor 表；之后以库里的游标为准）---------
BSC_START_BLOCK=
LAYER_START_BLOCK=

# ---- 轮询与容差（都有默认值，一般不用改）---------------------------------
# 快轮询只服务「锚点根」这一条规则，它是唯一有 120 秒窗口的。
# 模拟报告 §3.3 的工程指标是「轮询间隔 ≤ 10 秒」，超过 10000 会被配置校验拒绝。
WATCHDOG_POLL_MS=5000
WATCHDOG_SLOW_POLL_MS=30000
# 复核读之间的最小间隔：太短等于没换区块，太长吃掉 120 秒预算。
WATCHDOG_CONFIRM_DELAY_MS=1500
# 慢规则从 head 往回退多少个 BSC 块，躲开重组。快规则不退块，靠第二个 RPC 复核。
WATCHDOG_SLOW_DEPTH=15
# 滚动释放率窗口，秒。
WATCHDOG_ROLLING_WINDOW_SEC=86400
# eth_getLogs 窗口：公共 BSC RPC 限 3000 块，Besu 默认 5000。
BSC_LOG_RANGE=3000
LAYER_LOG_RANGE=5000
# 释放率的 bps 容差（吸收整除取整）。
WATCHDOG_RELEASE_TOLERANCE_BPS=50
# 回购滑点的额外容差：我们的参考价读在交易前一个区块上，价格本来就会动。
WATCHDOG_SLIPPAGE_TOLERANCE_BPS=100
# 对账 diff 的绝对容差，wei。默认 0：在途额度是显式算出来扣掉的，不靠这个数兜底。
WATCHDOG_RECONCILE_TOLERANCE_WEI=0
# 在途存款的扫描深度（BSC 区块数）。1200 块 ≈ 1 小时，远大于入场的约 1 分钟。
WATCHDOG_INFLIGHT_BLOCKS=1200

# ---- 告警外发（可插拔，不绑任何一家服务）---------------------------------
# 留空 = 告警只进日志（stderr 上的 alert 行）与非零退出码。
WATCHDOG_WEBHOOK_URL=
# json = 原样 POST 结构化告警；text = POST {"text": "..."}（Slack / 飞书 / 企业微信都吃这个形状）
WATCHDOG_WEBHOOK_FORMAT=json
WATCHDOG_WEBHOOK_TIMEOUT_MS=5000
WATCHDOG_WEBHOOK_RETRIES=2

# ---- 跳闸之后 ------------------------------------------------------------
# 跳过闸的看门狗在重启时会**立刻再退出一次**（退出码 3），直到有人来看。
# 人工确认处理完之后，把 findings 表里那几行的 state 改成 cleared，或者临时设成 true 重启。
WATCHDOG_RESUME_AFTER_TRIP=

# ---- 日志 ----------------------------------------------------------------
LOG_LEVEL=
