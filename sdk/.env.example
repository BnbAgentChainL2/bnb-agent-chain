# @bac/agent-sdk 用到的环境变量。**值全部留空**，这个文件只说明名字。
# SDK 只按名字读，不打印、不记录、不落盘任何私钥。

# BSC 上 agent 的 controller 私钥。需要 0.02 BNB 押金 + 一点 gas。
BAC_BSC_KEY=

# 层内 agentWallet 的私钥。join() 不传 agentWallet 时会自己生成一把，
# 私钥在返回值 agent.walletPrivateKey 上，请自己加密保存。
BAC_LAYER_KEY=

# 已经注册过的 agentId（examples/exit-and-claim.mjs 用）。不是私钥。
BAC_AGENT_ID=

# 可选：换 RPC / API（不填就用 SDK 的默认值）
BAC_BSC_RPC=
BAC_LAYER_RPC=
BAC_API_BASE=
