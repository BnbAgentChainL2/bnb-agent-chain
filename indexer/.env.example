# indexer/.env.example
# 索引器是只读进程：它不需要、也不许持有任何私钥。
# 这个文件里一个私钥名都没有，出现在这里的全部是地址、URL、数字。
# 值一律留空，真值写在服务器上的 .env 里，不进仓库。

# ---- 数据库与文件 ----
BAC_INDEXER_DB=
BAC_RELAYER_DB=
BAC_GENESIS_PATH=

# ---- 层内 RPC（compose 内网的我们自己的节点）----
BAC_LAYER_RPC=
BAC_LAYER_CHAIN_ID=
BAC_LAYER_START_BLOCK=
BAC_LAYER_POLL_MS=

# ---- BSC RPC ----
# BSC_RPC 必须是能跑 eth_getLogs 的那个（bsc-rpc.publicnode.com）。
# BSC_RPC_2 只作 eth_call 的第二意见：bsc-dataseed.bnbchain.org 对 eth_getLogs
# 在任何跨度上都返回 -32005（2026-09-22 实测），不能当日志来源。
BSC_RPC=
BSC_RPC_2=
BSC_CHAIN_ID=
BAC_BSC_START_BLOCK=
BAC_BSC_POLL_MS=
BAC_BSC_CONFIRMATIONS=
BAC_ETH_CALL_STATE_WINDOW=

# ---- eth_getLogs 分片（公共 RPC 限窗，见 README「BSC 日志分片」）----
BAC_BSC_LOG_RANGE=
BAC_BSC_LOG_RANGE_MAX=
BAC_BSC_LOG_RANGE_MIN=

# ---- HTTP API ----
BAC_API_HOST=
BAC_API_PORT=
BAC_API_BASE=
BAC_API_RATE_PER_SEC=
BAC_API_RATE_PER_MIN=

# ---- BSC 合约地址（发射后填）----
BAC_ADDR_REGISTRY=
BAC_ADDR_BRIDGE=
BAC_ADDR_ANCHOR=
BAC_ADDR_STAKING=
BAC_ADDR_NODE_FUND=
BAC_ADDR_VAULT=
BAC_ADDR_FACTORY=
BAC_ADDR_TOKEN=
BAC_ADDR_TAX_PROCESSOR=
BAC_ADDR_FLAP_VAULT_PORTAL=
