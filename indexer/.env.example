# indexer/.env.example
# 索引器是只读进程：它不需要、也不许持有任何私钥。
# 这个文件里一个私钥名都没有，出现在这里的全部是地址、URL、数字。
# 值一律留空，真值写在服务器上的 .env 里，不进仓库。

# ---- 数据库与文件 ----
BAC_INDEXER_DB=
BAC_RELAYER_DB=
# 本机路径只在进程内用，不会出现在任何 API 返回体里；对外公布的是 ${BAC_API_BASE}/api/genesis 与文件的 keccak256。
BAC_GENESIS_PATH=

# ---- 层内 RPC（compose 内网的我们自己的节点）----
BAC_LAYER_RPC=
BAC_LAYER_CHAIN_ID=
BAC_LAYER_START_BLOCK=
BAC_LAYER_POLL_MS=

# ---- BSC RPC ----
# BSC_RPC 必须是能跑 eth_getLogs 的那个。bsc-rpc.publicnode.com 只给最近约 7k–20k 块（1–2.5 小时）的日志，
# 更老的一段返回 -32602「Archive requests require a personal token」（2026-09-23 实测）：
#   - 它只够「一直在线、紧跟链头」的日常摄入；
#   - 首次回填、或索引器停机超过这个窗口之后追赶，必须换成能查历史的、带密钥的日志 RPC，
#     否则摄入会停在原地并在 /api/health 里告警 bsc_log_history_unavailable（不跳过任何区块）。
# BSC_RPC_2 是快照只读 view（eth_call / getCode / getBalance）的兜底：主 RPC 出网络错误或限速时换它。
#   bsc-dataseed.bnbchain.org 对 eth_getLogs 在任何跨度上都返回 -32005（2026-09-22 实测），不能当日志来源，
#   所以 eth_getLogs 永远只走 BSC_RPC。两路都配了时主 RPC 只给 5 秒超时、重试 1 次，换到第二个后 10 分钟内一直用它。
BSC_RPC=
BSC_RPC_2=
BSC_CHAIN_ID=
# 配了 BSC 合约地址就**必须**设：部署交易所在的块（或略早几块），并且在日志 RPC 能查到的窗口之内。
# 留空 / 0 时 BSC 摄入拒绝启动并告警 bsc_start_block_unset；比它更早的 treasury 行 API 一律不认。
BAC_BSC_START_BLOCK=
BAC_BSC_POLL_MS=
BAC_BSC_CONFIRMATIONS=
BAC_ETH_CALL_STATE_WINDOW=

# ---- eth_getLogs 分片（公共 RPC 限窗，见 README「BSC 日志分片」）----
BAC_BSC_LOG_RANGE=
BAC_BSC_LOG_RANGE_MAX=
BAC_BSC_LOG_RANGE_MIN=

# ---- HTTP API ----
BAC_API_HOST=
BAC_API_PORT=
BAC_API_BASE=
BAC_API_RATE_PER_SEC=
BAC_API_RATE_PER_MIN=

# ---- 决策 #19：agent 造出来的东西（03 §7）----
# 解码规则说明页的地址。那一页还没上线，留空即 detection.rulesUrl 返回 null，前端退化成纯文字说明。
BAC_DETECTION_RULES_URL=
# 每个候选合约的 eth_call 预算上限（默认 16）。探测必须便宜。
BAC_PROBE_MAX_CALLS=

# ---- 层内公开信息 ----
# 官方节点的 enode，与 https://bnbagentchain-rpc.xyz/node.json 里那一条逐字一致。
# 格式必须是 enode://<128 位十六进制公钥>@<host>:<port>，不对就当没配（/api/health 的 layer.enode 返回 null 并告警）。
# genesisHash 不用配：索引器自己用 eth_getBlockByNumber(0) 从层内 RPC 读。
BAC_LAYER_ENODE=

# ---- BSC 合约地址（v2：决策 #29 / #30 / #31；部署后填）----
# BacBridge 填 ERC1967 **代理**地址，不是实现合约。填错了（地址上 EIP-1967 实现槽是空的）快照会告警 bridge_not_proxy、
#   不读它的任何 view，/api/health.ok 为 false。
BAC_ADDR_BRIDGE=
# BacTaxRouter：Flap 的 beneficiary / marketingAddress（无 owner、不可升级）。
BAC_ADDR_ROUTER=
BAC_ADDR_ANCHOR=
BAC_ADDR_STAKING=
BAC_ADDR_NODE_FUND=
# BSC_CHAIN_ID=56 时下面三个有默认值（决策 #35 / #31 / #30），留空即用默认值：
#   BAC_ADDR_TOKEN              0xA97452d175679B2bF5F25a9a382D22aff39b7777（发射前这个地址上没有代码）
#   BAC_ADDR_IDENTITY_REGISTRY  0x8004A169FB4a3325136EB29fA0ceB6D2e539a432（ERC-8004 Identity Registry）
#   BAC_ADDR_FLAP_PORTAL        0xe2cE6ab80874Fa9Fa2aAE65D277Dd6B8e65C9De0（Flap Portal v5.24.0）
BAC_ADDR_TOKEN=
BAC_ADDR_IDENTITY_REGISTRY=
BAC_ADDR_FLAP_PORTAL=
# TaxProcessor 留空即可：发射后从 token.taxProcessor() 自动发现。
BAC_ADDR_TAX_PROCESSOR=
# ERC-8004 身份读数：每轮快照最多读几个 agent（默认 10）、多久重读一次（秒，默认 3600）。
BAC_IDENTITY_BATCH=
BAC_IDENTITY_REFRESH_SEC=
#
# 已删除（决策 #30 / #31），设了会在 /api/health 里告警 legacy_address_env_set：
#   BAC_ADDR_REGISTRY  BAC_ADDR_VAULT  BAC_ADDR_FACTORY  BAC_ADDR_FLAP_VAULT_PORTAL
