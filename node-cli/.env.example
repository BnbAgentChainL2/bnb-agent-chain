# 复制成 validator.env（chmod 600），永远不要提交、不要贴进聊天窗口。
# 本程序只按**变量名**读私钥，从不打印、不落盘、不上传。

# 见证人在 BSC 上的签名私钥。它要做三件事：commitAttestation / revealAttestation / claimReward。
# 里面需要一点 BNB 付 gas（每纪元两笔，0.05 gwei 下约 0.00001 BNB/天）。
VALIDATOR_PRIVATE_KEY=

# —— 下面这些有默认值，不填也能跑 ——

# 本地层内节点的 RPC。compose 内是 http://besu:8545，本机跑是 http://127.0.0.1:8545
LAYER_RPC=

# BSC RPC。两个独立 RPC 给出一致结果才算数（03 §1.2）
BSC_RPC=
BSC_RPC_2=

# 工作目录（配置、data、secrets、state 都在这里）。也可以用 --home 传
BAC_HOME=

# 注意：**节点密钥不在这里**。它由 bac-node init 生成在 secrets/key（0600），
# 同时是 enode 身份；换机迁移要带走，丢了就换 enode。
