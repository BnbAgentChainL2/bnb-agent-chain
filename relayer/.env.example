# 中继的环境变量（只写名字，值一律留空）。复制为 .env 或 secrets/relayer.env，永远不要提交。
# 私钥只从这里按**变量名**读取，进程内不打印、不落盘、不进日志（src/log.mjs 会把它从任何输出里擦掉）。

# ---- 私钥（两条 EOA，可以是两把不同的钥）----
RELAYER_PRIVATE_KEY=
RELAYER_LAYER_PRIVATE_KEY=

# ---- RPC ----
# BSC 必须两个**独立**的 RPC：只有两边给出一致的 finalized 才算数（03 §1.2）。
BSC_RPC=https://bsc-rpc.publicnode.com
BSC_RPC_2=https://bsc-dataseed.bnbchain.org
# 层内走 compose 内网的自家节点；QBFT 即时最终性，层侧不做确认深度、不做孤块处理。
LAYER_RPC=http://besu:8545
LAYER_WS=ws://besu:8546
LAYER_FINALITY=instant

# ---- SQLite ----
DB_PATH=/var/bac/relayer.db

# ---- BSC 侧合约地址（发射后回填，EIP-55 校验和格式）----
BAC_BRIDGE=
AGENT_REGISTRY=
CHAIN_ANCHOR=

# ---- 层内地址 ----
# 三个创世系统合约的地址由 02-CHAIN-SPEC §2 写死，下面是默认值，通常不用改。
L2_BRIDGE=0x0000000000000000000000000000000000000101
L2_GATE=0x0000000000000000000000000000000000000102
AGENT_BOOK=0x0000000000000000000000000000000000000103
FEE_SINK=0x000000000000000000000000000000000000dEaD
# 出块者（QBFT 提案者）的 EOA：小费进这里，对账时必须与 FeeSink 分开读。
# 03 §3.1 的 howToCheck 里把它叫 CLIQUE_SIGNER（历史名字，QBFT 下就是验证者自己的地址），
# 两个名字都认，优先 LAYER_SIGNER_ADDRESS。
LAYER_SIGNER_ADDRESS=
CLIQUE_SIGNER=

# ---- 扫描起点（第一次启动时写进 cursor 表；之后以库里的游标为准）----
BSC_START_BLOCK=
LAYER_START_BLOCK=
# 第一个要上报的纪元（= 链上第一个锚点的 epoch）。留空则按层内创世块的时间戳推算。
FIRST_EPOCH=

# ---- 轮询与限流（都有默认值，一般不用改）----
BSC_POLL_MS=15000
LAYER_POLL_MS=3000
BSC_LOG_RANGE=3000

# 决策 #17：gas 费分账合约（层内创世合约，留空用默认 0x…0104）
FEE_SPLITTER=
# everValidator 累积表：历史上出现过的全部验证者地址，逗号分隔。
# 留空时退回 LAYER_SIGNER_ADDRESS 一个地址（阶段 1 的真实情况）。对账要按这张表逐个读余额。
LAYER_VALIDATORS=
